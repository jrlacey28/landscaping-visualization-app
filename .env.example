
# Database
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# API Keys (Required)
OPENAI_API_KEY=your_openai_api_key_here
REPLICATE_API_TOKEN=your_replicate_token_here
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Environment Variables
NODE_ENV=development
PORT=5000
APP_URL=https://your-production-domain.com
GOOGLE_CALLBACK_URL=https://your-production-domain.com/api/auth/google/callback
GEMINI_STANDARD_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_BUSINESS_IMAGE_MODEL=gemini-3.1-flash-image-preview

# Security: use independent cryptographically random values (32+ characters).
SESSION_SECRET=
JWT_SECRET=
# Set the real OAuth credentials to enable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Verified sender required for account verification, password resets and quote email.
RESEND_API_KEY=
EMAIL_FROM=
# Optional PEM CA chain for databases using a private certificate authority.
DATABASE_SSL_CA=
